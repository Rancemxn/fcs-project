#fcs 5.0.0
format { profile: renderable; }
tempoMap { 0beat -> 120bpm; }
render profile 1.0.0 {
    viewport { width: 8px; height: 8px; colorSpace: "linear-srgb"; }
    layer main {
        pass: "overlay";
        children {
            clipGroup root {
                clip.kind: "rect";
                clip.fillRule: "nonzero";
                clip.origin: vec2(-1px, -3px);
                clip.size: vec2(2px, 6px);
                children {
                    rect target {
                        origin: vec2(-3px, -3px);
                        size: vec2(6px, 6px);
                        fill: solid(#FFFFFFFF);
                    }
                }
            }
        }
    }
}
